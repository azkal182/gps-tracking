# API proxy used by the Vite development server.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Configure either a complete style URL or a browser-restricted MapTiler key.
# This key is public browser configuration; restrict it to the portal origin and map-read scope.
VITE_MAP_STYLE_URL=
VITE_MAPTILER_KEY=
