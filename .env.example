# Salin ke .env lalu isi POSTGRES_PASSWORD dengan nilai lokal yang dibuat sendiri.
APP_ENV=development
BIND_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:5173
POSTGRES_DB=tracker_dev
POSTGRES_USER=tracker_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Generate 32 random bytes and encode URL-safe Base64 without padding. Keep old keys as MFA_ENCRYPTION_KEY_<version> during rotation.
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_VERSION=1
# Separate 32-byte URL-safe Base64 key for encrypted email outbox payloads.
OUTBOX_ENCRYPTION_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=none
SMTP_FROM="Backend Tracker <no-reply@localhost>"
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional distinct login principal granted gps_tracking_mailer; leave empty to disable delivery.
MAILER_DATABASE_URL=
# CLI-only principal granted gps_tracking_auth; never use it for the HTTP server.
AUTH_DATABASE_URL=
# Generate each runtime password with `openssl rand -hex 24`; provision roles with scripts/dev_db_roles.sh.
TRACKER_AUTH_DB_PASSWORD=
DATABASE_URL=
# Distinct HTTP tracking-data principal granted only gps_tracking_app.
TRACKER_APP_DB_PASSWORD=
TRACKING_DATABASE_URL=
# Optional separate HTTP management principal granted gps_tracking_platform_provisioner.
PLATFORM_DATABASE_URL=
# Tracking status thresholds (seconds); defaults are 60s position freshness and 180s offline timeout.
POSITION_FRESHNESS_SECONDS=60
DEVICE_OFFLINE_TIMEOUT_SECONDS=180
# Position history retention. Valid range: 1-36500 days; defaults to 365. Apply to new writes and retention cleanup.
POSITION_RETENTION_DAYS=365
# Development-only seed CLI: localhost DB URL ending in _dev/_test; choose a 12+ character local password.
GPS_DEV_SEED_DATABASE_URL=
GPS_DEV_SEED_PASSWORD=
# Optional exact peer IP allowed to supply X-Real-IP for rate limiting.
TRUSTED_PROXY_IP=
# Optional browser map provider style. Keep API keys local; Vite only exposes VITE_* values to the portal.
VITE_MAPTILER_KEY=
VITE_MAP_STYLE_URL=
