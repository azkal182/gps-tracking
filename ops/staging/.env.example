# This is a template. Copy to the VPS as /opt/gps-tracker/.env and chmod 600.
# Never commit the filled .env file.
GHCR_OWNER=your-github-user-or-org-lowercase
STAGING_DOMAIN=staging.example.com
IMAGE_TAG=0000000000000000000000000000000000000000

POSTGRES_DB=tracker_staging
POSTGRES_USER=tracker_admin
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX
TRACKER_AUTH_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX
TRACKER_APP_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX
TRACKER_PLATFORM_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX
TRACKER_MAILER_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX
TRACKER_RETENTION_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX

# Generate each key using: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_URLSAFE_BASE64
MFA_ENCRYPTION_KEY_VERSION=1
OUTBOX_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_32_BYTE_URLSAFE_BASE64

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM="Backend Tracker Staging <no-reply@example.com>"
SMTP_USERNAME=REPLACE_WITH_STAGING_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_STAGING_SMTP_PASSWORD

POSITION_FRESHNESS_SECONDS=60
DEVICE_OFFLINE_TIMEOUT_SECONDS=180
POSITION_RETENTION_DAYS=365
STAGING_BACKUP_DIR=/opt/gps-tracker/backups
