# Mount repo1-path from backup storage separate from the PostgreSQL data volume
# and preferably from the database host/failure domain. Do not store the cipher
# passphrase in this file or in source control.
[global]
repo1-path=/mnt/gps-tracker-backup/pgbackrest
repo1-cipher-type=aes-256-cbc
repo1-retention-full-type=time
repo1-retention-full=30
start-fast=y
process-max=4
archive-timeout=60
log-level-console=info

[gps-tracker]
pg1-path=/var/lib/postgresql/data
